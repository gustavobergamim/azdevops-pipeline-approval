{
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "sourceMap": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "target": "ES2017",
    "rootDir": "src/",
    "outDir": "dist/",
    "jsx": "react",
    "lib": ["ES2017", "dom"],
    "types": ["react"],
    "paths": {
      "@src-root/*": [ "./src/*" ]
    },
  },
  "exclude": ["node_modules", "typings"]
}
